# Daily pipeline service; ExecStart runs all four steps as the configured user in the project directory.
[Unit]
Description=Jagent daily job-search pipeline
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@PROJECT_DIR@
ExecStart=@PROJECT_DIR@/deploy/daily.sh

[Install]
WantedBy=multi-user.target
